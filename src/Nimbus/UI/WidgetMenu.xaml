<Window x:Class="Nimbus.UI.WidgetMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nimbus.UI"
        Title="{l:T Widgets.MenuTitle}" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" FontFamily="{StaticResource UiFont}"
        Foreground="#FFF3F3F7">

    <!-- Always dark, whatever Nimbus's theme: it sits on top of a game. Same glass, switches and buttons as the settings window. -->
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF3F3F7" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3F3F3F7" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#61F3F3F7" />
        <SolidColorBrush x:Key="GlassBrush" Color="#0EFFFFFF" />
        <SolidColorBrush x:Key="GlassHoverBrush" Color="#17FFFFFF" />
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="InputBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="InputHoverBrush" Color="#17FFFFFF" />
        <SolidColorBrush x:Key="ToggleOffBrush" Color="#29FFFFFF" />
        <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#FF0B0B10" />

        <Style x:Key="MenuSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="18,0" />
            <Setter Property="Background" Value="#16FFFFFF" />
        </Style>
    </Window.Resources>

    <!-- Covers Roblox's game area while open: dimmed game, falling snow, and the widget list in the middle.
         Clicking anywhere outside the list closes it. -->
    <Grid x:Name="Root" Background="#01000000" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Canvas x:Name="Snow" IsHitTestVisible="False" ClipToBounds="True" />

        <Border x:Name="Panel" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F01A1A22"
                BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="18" MouseLeftButtonDown="Panel_MouseLeftButtonDown">
            <!-- Drawn once and reused, so the falling snow doesn't redo the shadow every frame -->
            <Border.CacheMode>
                <BitmapCache RenderAtScale="1" SnapsToDevicePixels="True" />
            </Border.CacheMode>
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <Grid>
                <!-- The settings window's accent glow, small -->
                <Border CornerRadius="18" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="0.6">
                            <GradientStop x:Name="GlowStop" Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="18,16,18,12">
                        <Image Source="/Assets/Nimbus.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T Widgets.MenuTitle}" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Margin="10,0" Background="#0EFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="14">
                        <StackPanel x:Name="Toggles" Margin="0,2" />
                    </Border>
                    <DockPanel Margin="14,14,14,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:T Apps.Done}" Click="Done_Click" Focusable="False" />
                        <Button Content="{l:T Widgets.ResetCard}" HorizontalAlignment="Left" Click="Reset_Click" Focusable="False" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
