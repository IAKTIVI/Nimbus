<Window x:Class="Nimbus.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nimbus.UI"
        Title="{l:T Welcome.InstallNimbus}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <ContentControl Style="{StaticResource WindowSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" ToolTip="{l:T Welcome.Close}" Click="Close_Click" />

            <!-- Language: defaults to Windows' language when Nimbus has it -->
            <Button x:Name="LanguageButton" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,6,0,0" Height="30" Padding="10,0"
                    WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:T Welcome.Language}" Click="Language_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock x:Name="LanguageName" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Lumen's sign-in card, Nimbus edition -->
            <StackPanel Grid.Row="1" Margin="40,0,40,34">
                <WrapPanel x:Name="LanguageList" HorizontalAlignment="Center" Margin="0,0,0,18" Visibility="Collapsed" />

                <Image Source="/Assets/Nimbus.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.6" />
                    </Image.Effect>
                </Image>

                <TextBlock x:Name="TitleText" Text="{l:T Welcome.WelcomeToNimbus}" Margin="0,20,0,0" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="LeadText" Text="{l:T Welcome.ALightweightLauncherFor}" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <Border Style="{StaticResource GlassPanel}" Margin="0,24,0,0" Padding="18,6">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style x:Key="Check" TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Width" Value="24" />
                            </Style>
                        </StackPanel.Resources>
                        <DockPanel Margin="0,10">
                            <TextBlock Style="{StaticResource Check}" Text="&#xE73E;" />
                            <TextBlock Text="{l:T Welcome.InstallsToYourUser}" FontSize="13.5" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Margin="0,10">
                            <TextBlock Style="{StaticResource Check}" Text="&#xE73E;" />
                            <TextBlock Text="{l:T Welcome.ThePlayButtonOn}" FontSize="13.5" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Margin="0,10">
                            <TextBlock Style="{StaticResource Check}" Text="&#xE73E;" />
                            <TextBlock Text="{l:T Welcome.DownloadsRobloxStraightFrom}" FontSize="13.5" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorPanel" Style="{StaticResource ErrorBox}" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" />
                </Border>

                <Button x:Name="InstallButton" Content="{l:T Welcome.InstallNimbus}" Style="{StaticResource PrimaryButton}" Margin="0,26,0,0"
                        Height="42" Padding="34,0" FontSize="15" HorizontalAlignment="Center" Click="Install_Click" />
                <TextBlock x:Name="HintText" Text="{l:T Welcome.YouCanUninstallIt}" Margin="0,14,0,0"
                           Style="{StaticResource CaptionText}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>
