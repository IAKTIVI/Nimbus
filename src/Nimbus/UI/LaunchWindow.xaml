<Window x:Class="Nimbus.UI.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nimbus.UI"
        Title="Nimbus" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- The whole card is draggable; buttons opt out below. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="400" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <ContentControl Style="{StaticResource WindowSurface}">
        <Grid x:Name="Card" Margin="24,22,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image x:Name="Logo" Source="/Assets/Nimbus.png" Width="52" Height="52" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="30" ShadowDepth="0" Opacity="0.55" />
                </Image.Effect>
            </Image>

            <StackPanel x:Name="Body" Grid.Column="1" Margin="18,2,0,0">
                <TextBlock x:Name="TitleText" Text="Nimbus" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="{l:T Card.Starting}" Margin="0,3,0,0" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />

                <ProgressBar x:Name="Progress" Style="{StaticResource GlowProgress}" Margin="0,16,0,0" IsIndeterminate="True" />

                <Border x:Name="ErrorPanel" Style="{StaticResource ErrorBox}" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12.5" LineHeight="18" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="LogButton" Content="{l:T Card.OpenLog}" Margin="0,0,8,0" Visibility="Collapsed" Click="Log_Click" />
                    <Button x:Name="RetryButton" Content="{l:T Card.TryAgain}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="Retry_Click" />
                    <Button x:Name="CancelButton" Content="{l:T Card.Cancel}" Click="Cancel_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>
