<Window x:Class="Nimbus.UI.ThanksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nimbus.UI"
        Title="Nimbus" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <ContentControl Style="{StaticResource WindowSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" ToolTip="{l:T Thanks.Close}" Click="Close_Click" />

            <StackPanel Grid.Row="1" Margin="40,0,40,32">
                <StackPanel.Resources>
                    <Style x:Key="Glyph" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                </StackPanel.Resources>

                <Image Source="/Assets/Nimbus.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="40" ShadowDepth="0" Opacity="0.6" />
                    </Image.Effect>
                </Image>

                <TextBlock Text="{l:T Thanks.ThanksForInstallingNimbus}" Margin="0,20,0,0" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                <Border Style="{StaticResource GlassPanel}" Margin="0,22,0,0" Padding="18,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{l:T Thanks.NimbusIsYourRoblox}" FontSize="13.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource PrimaryButton}" Margin="0,24,0,0" Height="42" Padding="34,0" FontSize="15"
                        HorizontalAlignment="Center" Click="Play_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                        <TextBlock Text="{l:T Thanks.PlayRoblox}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <UniformGrid Columns="3" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Button Margin="4,0" Padding="14,0" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                            <TextBlock Text="{l:T Thanks.Settings}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4,0" Padding="14,0" ToolTip="{l:T Thanks.JoinTheNimbusDiscord}" Click="Discord_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BD;" />
                            <TextBlock Text="{l:T Thanks.Discord}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4,0" Padding="14,0" ToolTip="{l:T Thanks.NimbusOnGitHub}" Click="GitHub_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE943;" />
                            <TextBlock Text="{l:T Thanks.GitHub}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </ContentControl>
</Window>
