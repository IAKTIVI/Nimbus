<UserControl x:Class="Nimbus.UI.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nimbus.UI"
             xmlns:c="clr-namespace:Nimbus.UI.Controls">
    <StackPanel>

        <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Profiles.Presets}" />
        <UniformGrid x:Name="PresetGrid" Columns="3" />

        <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Profiles.YourProfiles}" />
        <Border Style="{StaticResource GlassPanel}">
            <StackPanel>
                <StackPanel x:Name="CustomList" />
                <Border Style="{StaticResource RowSeparator}" />
                <c:SettingRow Title="{l:T Profiles.SaveCurrentSettings}" Description="{l:T Profiles.SaveCurrentSettingsDesc}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="200">
                            <TextBox x:Name="NewNameBox" TextChanged="NewName_TextChanged" KeyDown="NewName_KeyDown" />
                            <TextBlock x:Name="NewNameHint" Text="{l:T Profiles.ProfileName}" Margin="12,0" VerticalAlignment="Center" FontSize="13"
                                       IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>
                        <Button Content="{l:T Profiles.Save}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Save_Click" />
                    </StackPanel>
                </c:SettingRow>
                <TextBlock x:Name="NameError" Margin="18,0,18,14" FontSize="12" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T Profiles.Reset}" />
        <Border Style="{StaticResource GlassPanel}">
            <c:SettingRow Title="{l:T Profiles.RobloxDefaults}" Description="{l:T Profiles.RobloxDefaultsDesc}">
                <Button Content="{l:T Profiles.Reset}" Click="Reset_Click" />
            </c:SettingRow>
        </Border>

        <TextBlock Style="{StaticResource CaptionText}" Margin="6,14,0,0"
                   Text="{l:T Profiles.ProfilesSetTheOptions}" />

    </StackPanel>
</UserControl>
