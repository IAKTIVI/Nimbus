<UserControl x:Class="Nimbus.UI.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Nimbus.UI">
    <StackPanel>

        <!-- Total playtime per game, kept even when old sessions drop out of the list below -->
        <StackPanel x:Name="MostPlayedSection">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="0,0,0,8" Content="{l:T History.ClearPlaytime}" Click="ClearPlaytime_Click" />
                <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T History.MostPlayed}" />
            </DockPanel>
            <Border Style="{StaticResource GlassPanel}">
                <StackPanel x:Name="MostPlayedList" />
            </Border>
            <TextBlock Style="{StaticResource SectionLabel}" Text="{l:T History.Recent}" />
        </StackPanel>

        <DockPanel x:Name="Header" Margin="0,16,0,0">
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="{l:T History.ClearHistory}" Click="Clear_Click" />
            <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                       Text="{l:T History.GamesYouPlayedThrough}" />
        </DockPanel>

        <Border Style="{StaticResource GlassPanel}" Margin="0,14,0,0">
            <StackPanel x:Name="List" />
        </Border>

    </StackPanel>
</UserControl>
