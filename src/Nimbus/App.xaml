<Application x:Class="Nimbus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] is the color theme; ThemeManager swaps it for Light.xaml / Dark.xaml at runtime -->
                <ResourceDictionary Source="UI/Themes/Dark.xaml" />
                <ResourceDictionary Source="UI/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
